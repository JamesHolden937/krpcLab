# Python: the CPython and PyPy venvs (run.sh / kspSim/tools/pypysetup.sh rebuild them).
.venv/
.venv-pypy/
.pypy/
__pycache__/
*.pyc

# Flight logs and batch outputs: large, per-machine, and cited by number in the docs.
logs/
logs_baseline/
logs_r2/

# Generated single-file bundles (./tools/bundle.py rebuilds them).
dist/

# The measurement farm's game copies and wine prefixes: 15 GB, rebuilt by
# mkbase.sh / mkclone.sh.  The scripts and mod sources beside them are tracked.
testInstances/base/
testInstances/ksp[0-9]*/
testInstances/prefix[0-9]*/
testInstances/*.log

# kspSim: probed models (regenerate with kspSim/tools/probe.py, 1-5 min each)
# and the simulated/proxy instances' port directories.
kspSim/models/
testInstances/kspsim[0-9]*/
testInstances/kspproxy[0-9]*/

# Generated from a KSP instance by kspSim/tools/kscterrain.py --instance 0
kspSim/data/ksc_terrain.json
.wt-*/
.venv
.venv-pypy

# Built from the tracked .cs by testInstances/mkbase.sh (mcs against KSP's
# own Managed assemblies).
testInstances/*Src/*.dll
# savegen.py outputs listed in saves/derived.txt; syncSaves.sh rebuilds them.
saves/qs_e[2468]0.sfs
saves/qs_e[2468]0.loadmeta
saves/qs_shuttle_inc.sfs
saves/qs_shuttle_high.sfs
saves/qs_shuttle2_inc.sfs
saves/qs_shuttle2_high.sfs
saves/qs_shuttle2_inc_rigoff.sfs
saves/qs_shuttle2_high_rigoff.sfs
saves/qs_shuttle2_ecc_rigoff.sfs
# Output of a farm verification run.
testInstances/verify*.txt
.kspPath
