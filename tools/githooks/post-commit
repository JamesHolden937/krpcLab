#!/bin/sh
# Rebuild and selftest dist/krpcLab.py (tools/bundle.py) after every commit,
# then, in the background, run the offline suite against it.  A failure is
# reported, never blocks: the commit has already happened.
cd "$(git rev-parse --show-toplevel)" || exit 0
PY=python3
[ -x .venv-pypy/bin/python ] && PY=.venv-pypy/bin/python
"$PY" tools/bundle.py --quiet >/dev/null 2>.git-bundle-error.log \
    || { echo "bundle FAILED -- see $(pwd)/.git-bundle-error.log" >&2; exit 0; }
rm -f .git-bundle-error.log
# Not beside the farm: the suite on top of six instances is killed by
# memory pressure (CLAUDE.md).
pgrep -f KSP_x64.exe >/dev/null 2>&1 && exit 0
# Outside the tree: a bundle's modules sit beside it, and beside one in the
# root they would be the tree's own files.
T=$(mktemp -d) || exit 0
( "$PY" tools/bundle.py --suite --no-selftest --quiet -o "$T/krpcLab.py" \
      >/dev/null 2>.git-bundle-error.log && rm -f .git-bundle-error.log
  rm -rf "$T" ) </dev/null >/dev/null 2>&1 &
exit 0
