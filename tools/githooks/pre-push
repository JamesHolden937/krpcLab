#!/bin/sh
# Before a push: a pilot whose code changed after its docs/<pilot>/howItWorks.pdf
# gets a reminder (never blocks).  If the change did not alter behaviour:
#   git config krpclab.howItWorksOk.<pilot> <commit>   silences it up to <commit>.
cd "$(git rev-parse --show-toplevel)" || exit 0
for pdf in docs/*/howItWorks.pdf; do
  p=$(basename "$(dirname "$pdf")"); [ -d "$p" ] || continue
  base=$(git log -1 --format=%H -- "$pdf")
  ok=$(git config "krpclab.howItWorksOk.$p")
  [ -n "$ok" ] && git merge-base --is-ancestor "$base" "$ok" 2>/dev/null && base=$ok
  n=$(git rev-list --count "$base..HEAD" -- "$p" ":!$p/tests" ":!$p/tools" ":!$p/*.md" 2>/dev/null || echo 0)
  [ "$n" -gt 0 ] || continue
  echo "pre-push: $p has $n code commit(s) since $pdf ($(git log -1 --format=%cd --date=short -- "$pdf")): if its behaviour changed, write the page afresh from the code in the scratchpad (HTML, inline SVG figures), print it with ~/.cache/ms-playwright/chromium-1228/chrome-linux64/chrome --headless --no-pdf-header-footer --print-to-pdf=$pdf page.html (keep no HTML), commit and push again. It says what the program does and what triggers what -- phases, transitions, the laws each phase flies, with figures -- never history (no earlier errors, refuted ideas, flight counts, 'it used to'; those go in the journal). Unchanged behaviour: git config krpclab.howItWorksOk.$p $(git rev-parse --short HEAD)" >&2
done
exit 0
